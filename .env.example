# ─────────────────────────────────────────────────────────────────────
# agent-base configuration
# Copy to .env and adjust. NEVER commit the real .env file.
# This file is the config CONTRACT, consumed by core/config.py from Stage 1.
# ─────────────────────────────────────────────────────────────────────

# ── Modules ──────────────────────────────────────────────────────────
# Agent module names to load, comma-separated (order = assembly order).
# JSON array form is also accepted, e.g. AGENT_MODULES=["chat","writer"].
# Modules live in src/agent_base/modules/<name>/.
# Unknown names or duplicates fail startup (fail-fast). See ADR-002.
# 'supervisor' is a RESERVED entrypoint name (multi-agent session over all
# loaded modules) — never name a module 'supervisor'.
AGENT_MODULES=chat,writer

# ── Service (CORS) ────────────────────────────────────────────────────
# Origins allowed to call the SSE endpoint cross-origin (browser clients,
# e.g. the agent-base-ui frontend). Comma-separated; JSON array also works.
# The default covers the agent-base-ui dev server on localhost:3000.
CORS_ORIGINS=http://localhost:3000

# ── LLM provider (openai-compatible) ─────────────────────────────────
# provider: deepseek | zhipu | openai-compatible
LLM_PROVIDER=deepseek
# Required. In production the app refuses to start without it (no weak
# defaults, lesson from chat-agent review SEC-C2).
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── Conversation state (checkpointer) ────────────────────────────────
# backend: memory | sqlite
# NOTE: this is SHORT-TERM dialogue state only (LangGraph native).
# Long-term memory is out of scope for the base (see scope red line).
CHECKPOINTER_BACKEND=memory
# Used only when CHECKPOINTER_BACKEND=sqlite
CHECKPOINTER_SQLITE_PATH=./agent_base_state.db

# ── Tool pool (Stage 3) ──────────────────────────────────────────────
# Wall-clock budget per tool execution (seconds). Over-budget tools are
# cut off and the error is fed back to the model as a ToolMessage.
TOOL_TIMEOUT_SECONDS=30

# ── Environment ──────────────────────────────────────────────────────
# development | production
# production enforces strict config validation (fail-fast on missing keys).
ENV=development

# ── Observability (optional, env-gated, never hardcoded) ─────────────
# Structured JSON log lines. Default false (human-readable). Production
# deployments should set true for machine-parseable logs.
LOG_JSON=false
# LangSmith tracing is consumed natively by langchain via its env vars;
# the base only surfaces their state, it never imports vendor SDKs.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Langfuse (if used): public + secret keys enable its native callback.
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
