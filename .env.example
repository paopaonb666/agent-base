# ─────────────────────────────────────────────────────────────────────
# agent-base 配置
# 复制为 .env 并按需调整。绝不要提交真实的 .env 文件。
# 本文件是配置契约（CONTRACT），自阶段 1 起由 core/config.py 消费。
# ─────────────────────────────────────────────────────────────────────

# ── 模块 ──────────────────────────────────────────────────────────
# 要加载的 agent 模块名，逗号分隔（顺序即装配顺序）。
# 也接受 JSON 数组形式，例如 AGENT_MODULES=["chat","writer"]。
# 模块位于 src/agent_base/modules/<name>/。
# 未知名字或重复会导致启动失败（快速失败）。见 ADR-002。
# 'supervisor' 是保留的入口名（对所有已加载模块的多 Agent 会话）
# ——永远不要把某个模块命名为 'supervisor'。
AGENT_MODULES=chat,writer

# ── Agent 循环 ──────────────────────────────────────────────────────
# 单轮 invoke 的图步数上限（含工具往返）：防止工具循环失控空转。
# planner 重度使用场景（子任务多、重规划频繁）最坏步数会超出默认值，
# 按需调高——估算见 core/config.py 的 PlannerSettings docstring。
AGENT_RECURSION_LIMIT=25

# ── Planner（任务规划模块，M9） ─────────────────────────────────────
# plan-execute-replan 的预算与防护：单次拆解的子任务上限 / 单个子任务
# 的工具轮数上限 / 重规划预算 / 子任务摘要的最小字符门槛（0=只拦空白）。
PLANNER_MAX_SUBTASKS=5
PLANNER_SUBTASK_TOOL_ROUNDS=8
PLANNER_MAX_REPLANS=2
PLANNER_MIN_SUMMARY_CHARS=0

# ── 服务（CORS） ────────────────────────────────────────────────────
# 允许跨域调用 SSE 端点的来源（浏览器客户端，例如 agent-base-ui 前端）。
# 逗号分隔；JSON 数组同样可用。默认覆盖 localhost:3000 上的 agent-base-ui
# 开发服务器。
CORS_ORIGINS=http://localhost:3000

# ── LLM provider（openai 兼容） ─────────────────────────────────
# provider：deepseek | zhipu | openai-compatible
LLM_PROVIDER=deepseek
# 必填。production 环境下没有它会拒绝启动（不使用弱默认值，
# chat-agent 评审 SEC-C2 的经验）。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# ── 对话状态（checkpointer） ────────────────────────────────
# backend：sqlite（默认，重启可恢复对话与工具调用记录）| memory（零依赖，
# 什么都不持久化）| mysql
# 注意：这里仅指短期对话状态（LangGraph 原生）；长期记忆（memory/）
# 的存储后端跟随同一选择。
CHECKPOINTER_BACKEND=sqlite
# 仅在 CHECKPOINTER_BACKEND=sqlite 时使用
CHECKPOINTER_SQLITE_PATH=./agent_base_state.db
# 仅在 CHECKPOINTER_BACKEND=mysql 时使用。
# MySQL >= 8.0.19 使用官方 saver；5.7 自动启用基座内置的兼容 saver
# （extensions/mysql57.py，详见该模块 docstring）。
CHECKPOINTER_MYSQL_HOST=127.0.0.1
CHECKPOINTER_MYSQL_PORT=3306
CHECKPOINTER_MYSQL_USER=root
CHECKPOINTER_MYSQL_PASSWORD=
CHECKPOINTER_MYSQL_DATABASE=agent_base

# ── 工具池（阶段 3） ──────────────────────────────────────────────
# 每次工具执行的挂钟时间预算（秒）。超预算的工具会被截断，
# 错误会作为 ToolMessage 反馈给模型。
TOOL_TIMEOUT_SECONDS=30
# 工具调用审计（M5）：每条调用（成功/超时/异常）写入 tool_call_records
# 表（跟随 CHECKPOINTER_BACKEND 落库），供 UI 面板与审计查询端点使用。
TOOL_CALL_LOG_ENABLED=true

# ── 工具库（tools/；M1 治理设施） ─────────────────────────────────
# 要装配进共享池的基座内置工具（逗号分隔）。默认只开零依赖工具；
# 高风险（python_repl）与依赖外部服务的工具（web_search）必须显式
# 开启。合法名字：current_time / calculator / json_query / web_search /
# python_repl。启用但不可用（缺依赖/缺配置）会在启动时报错。
TOOLKIT_ENABLED=current_time,calculator,json_query

# ── 网络搜索（tools/search；M3） ──────────────────────────────────
# 搜索引擎优先级（逗号分隔）：tavily（需 TAVILY_API_KEY）/ duckduckgo
# （免 key，需 pip install 'agent-base[search]'）。任一成功即返回。
SEARCH_ENGINE_PRIORITY=duckduckgo
TAVILY_API_KEY=
# ddgs 的上游引擎钉选。默认 "auto" 会同时扇出十几个上游，受限网络下
# 大量超时导致搜索超时归零；单钉可达引擎（duckduckgo / bing）实测快
# 一个数量级。代理用户还可设 DDGS_PROXY（ddgs 原生读取，如
# socks5://127.0.0.1:7890），或直接配 TAVILY_API_KEY 走纯 API 引擎。
SEARCH_DDGS_BACKEND=duckduckgo
# 单次引擎调用超时（秒）与结果缓存 TTL（秒）。ddgs 聚合多个上游引擎，
# 受限网络下经常超过 10s，默认 15s 是可用性与响应速度的折中。
SEARCH_TIMEOUT_SECONDS=15
SEARCH_CACHE_TTL_SECONDS=300

# ── 文档解析（工具库 tools/parsing；M4 前置） ─────────────────────
# 单个文档的输入大小封顶（字节），默认 10MB。超限直接报错。
DOC_PARSE_MAX_INPUT_BYTES=10485760
# 解析输出的文本长度封顶（字符）。超限截断并置 truncated 标志。
DOC_PARSE_MAX_OUTPUT_CHARS=50000

# ── 记忆系统（memory/；M6） ─────────────────────────────────────
# 总开关：关闭时不装配记忆服务，invoke 链路与既有行为完全一致。
MEMORY_ENABLED=true
# 语义检索（embedding）：openai 兼容 /embeddings 端点（默认硅基流动
# BAAI/bge-m3，1024 维，中英双语）。API key 留空时自动降级为 BM25
# 关键词 + 时间衰减检索，其余记忆功能不受影响。
MEMORY_EMBEDDING_ENABLED=true
MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
MEMORY_EMBEDDING_DIMS=1024
MEMORY_EMBEDDING_BATCH_SIZE=16
MEMORY_EMBEDDING_TIMEOUT_SECONDS=10
# 召回与注入预算：每轮最多召回的记忆条数与注入上下文的字符预算。
MEMORY_RECALL_TOP_K=6
# 召回最低分阈值（0..1）：低于该分的候选不召回。0.5 分隔纯噪音
#（实测 ≤0.47）与真实相关（≥0.59）；embedding 不可用的降级路径
# 自动放宽一半，防止误杀老而准的关键词命中。
MEMORY_RECALL_MIN_SCORE=0.5
MEMORY_CONTEXT_MAX_CHARS=3000
# chat 图模型侧 token 预算（M6d）：超出预算的旧历史被修剪出模型输入。
MEMORY_CONTEXT_MAX_TOKENS=12000
# 记忆形成管线（M6c）：每 N 轮对话后台跑一次抽取+整合。
MEMORY_CAPTURE_ENABLED=true
MEMORY_CAPTURE_EVERY_TURNS=1
# 会话滚动摘要（M6c/M6d）：线程内消息数超过阈值后触发摘要更新。
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_TRIGGER_MESSAGES=12
# 用户画像（M6c）：随对话合并演化的结构化画像。
MEMORY_PROFILE_ENABLED=true
# 遗忘策略：episodic 记忆保留天数（0 = 不过期）；检索打分的时间半衰期。
MEMORY_EPISODIC_TTL_DAYS=30
MEMORY_TIME_DECAY_HALF_LIFE_DAYS=14
# 抽取管线的单次输入字符上限。
MEMORY_EXTRACTION_MAX_INPUT_CHARS=8000
# 抽取转写的消息条数窗口：超长会话只取最近 N 条，更早事实靠滚动摘要承载。
MEMORY_EXTRACTION_MAX_MESSAGES=24
# 记忆身份鉴权（P0）：配置后请求必须带 X-User-Sig = HMAC-SHA256(X-User-Id, 密钥)，
# 否则 401（生成签名：python scripts/memory_user_sig.py --user-id alice --secret <密钥>）。
# 留空仅限 development 单机自用；production 且 MEMORY_ENABLED=true 时强制要求。
MEMORY_AUTH_SECRET=
# 画像注入的硬截断上限（字符）。
MEMORY_PROFILE_MAX_CHARS=1500
# 记忆 MySQL 连接池大小（CHECKPOINTER_BACKEND=mysql 时生效）。
MEMORY_MYSQL_POOL_SIZE=5
# 混合检索权重（向量,关键词,时间,显著度），和必须为 1（误差 0.01）。
MEMORY_WEIGHT_VECTOR=0.40
MEMORY_WEIGHT_KEYWORD=0.30
MEMORY_WEIGHT_RECENCY=0.15
MEMORY_WEIGHT_SALIENCE=0.15
# 文档知识库分块（M6e）：块长 + 相邻块重叠（重叠必须小于块长）。
MEMORY_DOC_CHUNK_CHARS=800
MEMORY_DOC_CHUNK_OVERLAP=100

# ── 环境 ──────────────────────────────────────────────────────
# development | production
# production 会强制严格的配置校验（缺少密钥即快速失败）。
ENV=development

# ── 可观测性（可选，由环境开关控制，绝不硬编码） ─────────────
# 结构化 JSON 日志行。默认 false（人类可读）。生产部署应设为 true
# 以获得机器可解析的日志。
LOG_JSON=false
# /health 是否真实探测 LLM 端点可达性（会打真实网络，默认关闭——
# 关闭时只校验 key 非空与 base_url 格式；生产环境可按需开启）。
LLM_HEALTH_PROBE_MODEL=false
# LangSmith 追踪由 langchain 通过其环境变量原生消费；
# 基座只暴露它们的状态，绝不导入厂商 SDK。
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Langfuse（如使用）：public + secret 密钥会启用其原生回调。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
