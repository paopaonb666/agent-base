# ─────────────────────────────────────────────────────────────────────
# agent-base 配置
# 复制为 .env 并按需调整。绝不要提交真实的 .env 文件。
# 本文件是配置契约（CONTRACT），自阶段 1 起由 core/config.py 消费。
# ─────────────────────────────────────────────────────────────────────

# ── 模块 ──────────────────────────────────────────────────────────
# 要加载的 agent 模块名，逗号分隔（顺序即装配顺序）。
# 也接受 JSON 数组形式，例如 AGENT_MODULES=["chat","writer"]。
# 模块位于 src/agent_base/modules/<name>/。
# 未知名字或重复会导致启动失败（快速失败）。见 ADR-002。
# 'supervisor' 是保留的入口名（对所有已加载模块的多 Agent 会话）
# ——永远不要把某个模块命名为 'supervisor'。
# 注意：示例值≠默认值。默认（不配置时）与两侧代码一致是 chat；启用多模块演示：
# AGENT_MODULES=chat,writer
AGENT_MODULES=chat
# 任务规划（M9）启用 planner 后，invoke 可用 mode=plan / auto 走
# plan-execute-replan 流程，例如 AGENT_MODULES=chat,planner
#
# 模块所在的包（导入前缀），逗号分隔，按顺序查找：默认只有基座自带的
# agent_base.modules。独立分发的模块包把包名加进来即可被发现；同名模块
# 出现在多个包时，靠前的包优先。模块名本身仍须唯一。
# AGENT_MODULE_PACKAGES=agent_base.modules,acme_modules

# ── Agent 循环 ──────────────────────────────────────────────────────
# 单轮 invoke 的图步数上限（含工具往返）：防止工具循环失控空转。
# planner 重度使用场景（子任务多、重规划频繁）最坏步数会超出默认值，
# 按需调高——估算见 core/config.py 的 PlannerSettings docstring。
AGENT_RECURSION_LIMIT=25
# 单轮 run 的 handoff 次数上限（#68）：超限后 supervisor 收到结构化提示
# 强制收敛，不再执行子图。0 = 不限。
AGENT_HANDOFF_MAX_PER_RUN=10
# 工具循环检测阈值（条目 5）：模型连续以相同 (工具名, 参数) 调用达到阈值
# 后，下一次同参请求被拦截——不执行，回喂一条结构化提示引导模型换参数/
# 换工具/基于已有结果直接收尾。0 = 关闭（完全沿用旧行为）。
AGENT_TOOL_LOOP_THRESHOLD=2

# ── Planner（任务规划模块，M9） ─────────────────────────────────────
# plan-execute-replan 的预算与防护：单次拆解的子任务上限 / 单个子任务
# 的工具轮数上限 / 重规划预算 / 子任务摘要的最小字符门槛（0=只拦空白）。
PLANNER_MAX_SUBTASKS=5
PLANNER_SUBTASK_TOOL_ROUNDS=8
PLANNER_MAX_REPLANS=2
PLANNER_MIN_SUMMARY_CHARS=0
# 语义判分（#63）：空=关（默认，只跑字数门）；llm=check 节点用 LLM 对每个
# 通过字数门的子任务输出判分（done/failed/partial），partial 定向补做一轮。
# 每子任务多一次小调用，成本敏感时保持关闭。
PLANNER_VERDICT=

# ── 服务（CORS） ────────────────────────────────────────────────────
# 允许跨域调用 SSE 端点的来源（浏览器客户端，例如 agent-base-ui 前端）。
# 逗号分隔；JSON 数组同样可用。默认覆盖 localhost:3000 上的 agent-base-ui
# 开发服务器。
CORS_ORIGINS=http://localhost:3000
# per-user 请求限流（次/分钟，#78 多用户硬前提）：令牌桶在 invoke 入口
# enforcement，超限 429 + Retry-After。0 = 不限（本机开发）；
# production 必须显式配置（>=1），否则拒绝启动。
RATE_LIMIT_PER_MINUTE=0
# 全局 run 并发上限（#79）：同时在途的 SSE 对话轮数。每轮 3 个线程，
# 上限防负载下线程膨胀。饱和请求快速失败 429 + Retry-After（不排队）。
# 0 = 不限；默认 32。
AGENT_RUN_CONCURRENCY=32
# SSE emitter 超时秒数（R1-F7）：半开连接（无 RST）会一直占上面的闸门
# 额度直到容器兜底；配置后 emitter 到点超时收尾并释放闸门。
# 0 = 关闭（默认，行为不变）。
AGENT_SSE_TIMEOUT_SECONDS=0

# ── LLM provider（openai 兼容） ─────────────────────────────────
# provider：deepseek | zhipu | openai-compatible
LLM_PROVIDER=deepseek
# 必填。production 环境下没有它会拒绝启动（不使用弱默认值，
# chat-agent 评审 SEC-C2 的经验）。
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
# 主路径弹性包：读超时（秒）/ 瞬时错误重试次数（指数退避）/ 全局并发
# 信号量（突发流量下 LLM 并发有界，防 provider 限流连锁）。重试另有
# 滑窗预算封顶（默认 60s 窗口 20 次），重试风暴在窗口边界被截断。
LLM_MAIN_TIMEOUT=600
# 估算 token 修正系数（#340）：provider 自有分词与本地 tokenizer 的系统性
# 比值，乘在上下文预算的消息计量上（>1 = 更早修剪、更保守）。默认 1.0；
# 按 cost_usage.prompt_tokens 增速对账后按 profile 调整。
LLM_TOKEN_FACTOR=1.0
LLM_FAST_TOKEN_FACTOR=1.0
LLM_MAIN_RETRIES=2
LLM_MAIN_CONCURRENCY=8
LLM_STREAM_IDLE_SECONDS=30
# 回落链（#71，Java 单边增强）：JSON 数组 [{"base_url","model","api_key"?}]，
# 主力重试+预算耗尽后逐链兜底；api_key 省略回落主力 key。默认不配置（无链）。
# LLM_FALLBACKS='[{"base_url":"https://api.example.com/v1","model":"gpt-4o-mini"}]'
# 熔断器（#72，Java 单边增强）：连续失败达到阈值即 open，冷却到期 half-open
# 单发探测。0 = 禁用（Python 无熔断——默认行为分歧，部署侧知悉）。
LLM_CIRCUIT_FAILURE_THRESHOLD=5
LLM_CIRCUIT_COOLDOWN_SECONDS=30
# 模型上下文窗口（token，#4）：0 = 未配置（上下文预算沿用
# MEMORY_CONTEXT_MAX_TOKENS 现状）；配置后输入预算 =
# min(预算, 窗口 - 输出预留 4096)——快档与主力各自生效。
LLM_MAX_CONTEXT_TOKENS=0

# ── LLM 快速档（免费/低价模型吃批量任务） ─────────────────────
# 可选。base_url 与 model 两者都非空才生效；未配置时快档调用方自动回落
# 主力配置。api_key 留空则共用 LLM_API_KEY（同一 provider 双档的常见形态）。
# 免费档普遍按并发数限速（如智谱 flash 免费档仅 1 并发）——消费方经
# ResilientLLM 信号量限流 + 重试耗尽回退主力模型，交互路径不要裸依赖快档。
# 例（智谱）：LLM_FAST_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#            LLM_FAST_MODEL=glm-4.5-flash
LLM_FAST_API_KEY=
LLM_FAST_BASE_URL=
LLM_FAST_MODEL=
LLM_FAST_CONCURRENCY=2
# 快档模型上下文窗口（token，#4）：0 = 未配置（回落主力窗口推导语义不变）。
LLM_FAST_MAX_CONTEXT_TOKENS=0

# ── 成本治理（T4.1/T4.2） ─────────────────────────────────────
# 总开关：开启后 build_llm 给全部模型客户端挂 usage 计量 callback，
# 并请求流式路径回报 usage（stream_usage）。关闭时零开销、零请求参数。
COST_ENABLED=false
# 日 / 月预算（元）。0 = 对应周期不限额。超限行为见 COST_ACTION。
COST_DAILY_CNY=0
COST_MONTHLY_CNY=0
# 超限行为：block=熔断（invoke 返回 429，只挡新的 LLM 消耗，检索/
# 历史/记忆管理端点不受影响）；warn=只告警放行。
COST_ACTION=block
# 价目表（手工维护，以各 provider 控制台实时价为准；2026 年价格波动
# 频繁）。单位：元 / 百万 tokens。未知模型按 0 元计量并告警一次。
# 示例（DeepSeek 2026 参考价）：
# COST_PRICES_JSON={"deepseek-chat": {"input_miss": 3, "input_hit": 0.25, "output": 6}}
COST_PRICES_JSON=

# ── MCP 工具来源（可选） ─────────────────────────────────────
# 总开关：开启即承诺——配置非法或 server 连不上都是启动时报错（绝不静默
# 缺席）。关闭时零解析、零连接。Java 版 transport 支持 stdio /
# streamable_http / sse（websocket 暂不支持）。
MCP_ENABLED=false
# MCP Server 清单（JSON）：server 名会成为工具名前缀（{server}_{tool}），
# 须为小写标识符。可选 timeout_seconds 为该 server 的 per-server 超时。
# MCP_SERVERS_JSON={"docs": {"transport": "stdio", "command": "uvx", "args": ["mcp-server-fetch"]}}
MCP_SERVERS_JSON=

# ── 对话状态（checkpointer） ────────────────────────────────
# backend：sqlite（默认，重启可恢复对话与工具调用记录）| memory（零依赖，
# 什么都不持久化）| mysql
# 注意：这里仅指短期对话状态（LangGraph 原生）；长期记忆（memory/）
# 的存储后端跟随同一选择。
CHECKPOINTER_BACKEND=sqlite
# 仅在 CHECKPOINTER_BACKEND=sqlite 时使用
CHECKPOINTER_SQLITE_PATH=./agent_base_state.db
# 仅在 CHECKPOINTER_BACKEND=mysql 时使用。
# MySQL >= 8.0.19 使用官方 saver；5.7 自动启用基座内置的兼容 saver
# （extensions/mysql57.py，详见该模块 docstring）。
CHECKPOINTER_MYSQL_HOST=127.0.0.1
CHECKPOINTER_MYSQL_PORT=3306
CHECKPOINTER_MYSQL_USER=root
CHECKPOINTER_MYSQL_PASSWORD=
CHECKPOINTER_MYSQL_DATABASE=agent_base

# ── 工具池（阶段 3） ──────────────────────────────────────────────
# 每次工具执行的挂钟时间预算（秒）。超预算的工具会被截断，
# 错误会作为 ToolMessage 反馈给模型。
TOOL_TIMEOUT_SECONDS=30
# 工具调用审计（M5）：每条调用（成功/超时/异常）写入 tool_call_records
# 表（跟随 CHECKPOINTER_BACKEND 落库），供 UI 面板与审计查询端点使用。
TOOL_CALL_LOG_ENABLED=true
# 工具结果不可信标记（#84）：web_search/knowledge_search/MCP 的结果进上
# 下文时头部包一行「非系统指令」标记（间接 prompt injection 护栏）。事件
# 与审计日志保持原文。默认关：标记文本进 prompt，开启前先灰度确认。
TOOL_RESULT_UNTRUSTED_MARKER=false
# 工具结果外置阈值（条目 6，字符）：单次工具结果超过该长度时全文外置进
# 附件存储（module="tool_result"），ToolMessage 只留摘要块（首屏 + 引用
# + read_tool_result 分页指引）。0 = 关闭；存储未装配（未知 checkpointer
# 后端）时自动停用。
TOOL_RESULT_SPILL_THRESHOLD=4000

# ── 工具库（tools/；M1 治理设施） ─────────────────────────────────
# 要装配进共享池的基座内置工具（逗号分隔）。默认只开零依赖工具；
# 高风险（python_repl）与依赖外部服务的工具（web_search）必须显式
# 开启。合法名字：current_time / calculator / json_query / web_search /
# python_repl。启用但不可用（缺依赖/缺配置）会在启动时报错。
TOOLKIT_ENABLED=current_time,calculator,json_query

# ── 网络搜索（tools/search；M3） ──────────────────────────────────
# 搜索引擎优先级（逗号分隔），任一成功即返回。Java 侧只实现 tavily
# （需 TAVILY_API_KEY，配置 duckduckgo 会在启动时被显式拒绝）；
# Python 侧默认 duckduckgo（免 key，需 pip install 'agent-base[search]'）。
SEARCH_ENGINE_PRIORITY=tavily
TAVILY_API_KEY=
# ddgs 的上游引擎钉选（Python 侧专属；Java 侧无 ddgs 引擎，设了会被
# 忽略并记 WARN）。默认 "auto" 会同时扇出十几个上游，受限网络下大量
# 超时导致搜索超时归零；单钉可达引擎（duckduckgo / bing）实测快一个
# 数量级。或直接配 TAVILY_API_KEY 走纯 API 引擎（两侧通用）。
SEARCH_DDGS_BACKEND=duckduckgo
# 单次引擎调用超时（秒）与结果缓存 TTL（秒）。ddgs 聚合多个上游引擎，
# 受限网络下经常超过 10s，默认 15s 是可用性与响应速度的折中。
SEARCH_TIMEOUT_SECONDS=15
SEARCH_CACHE_TTL_SECONDS=300

# ── 文档解析（工具库 tools/parsing；M4 前置） ─────────────────────
# 单个文档的输入大小封顶（字节），默认 10MB。超限直接报错。
DOC_PARSE_MAX_INPUT_BYTES=10485760
# 解析输出的文本长度封顶（字符）。超限截断并置 truncated 标志。
DOC_PARSE_MAX_OUTPUT_CHARS=50000

# ── 记忆系统（agent-base-memory 独立包；M6） ─────────────────────
# 0.3.0 起记忆子系统是独立发行包（pip install -e packages/agent-base-memory
# 或 pip install "agent-base[memory]"）：基座只保留 MemoryPort 契约与
# entry point 装配点。总开关默认 true（启用即承诺——缺包会在启动时快速失败
# 并提示安装命令）；关闭时不装配记忆服务，invoke 链路与既有行为完全一致。
# 记忆表由记忆包自己的迁移链管理：
#   python -m alembic -c packages/agent-base-memory/alembic.ini upgrade head
MEMORY_ENABLED=true
# 语义检索（embedding）：openai 兼容 /embeddings 端点（默认硅基流动
# BAAI/bge-m3，1024 维，中英双语）。API key 留空时自动降级为 BM25
# 关键词 + 时间衰减检索，其余记忆功能不受影响。
MEMORY_EMBEDDING_ENABLED=true
MEMORY_EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
MEMORY_EMBEDDING_API_KEY=
MEMORY_EMBEDDING_MODEL=BAAI/bge-m3
MEMORY_EMBEDDING_DIMS=1024
MEMORY_EMBEDDING_BATCH_SIZE=16
MEMORY_EMBEDDING_TIMEOUT_SECONDS=10
# 召回与注入预算：每轮最多召回的记忆条数与注入上下文的字符预算。
MEMORY_RECALL_TOP_K=6
# 召回最低分阈值（0..1）：低于该分的候选不召回。0.5 分隔纯噪音
#（实测 ≤0.47）与真实相关（≥0.59）；embedding 不可用的降级路径
# 自动放宽一半，防止误杀老而准的关键词命中。
MEMORY_RECALL_MIN_SCORE=0.5
# 高显著度豁免（#181）：salience ≥ 阈值的记忆豁免召回双门槛（常驻记忆
# 无词面/向量交集也可召回，仍按总分排尾）。0 = 关闭。注意：REST 可批量
# 标 salience=1.0 旁路门槛，部署方自行约束。
MEMORY_SALIENCE_EXEMPT_THRESHOLD=0.9
MEMORY_CONTEXT_MAX_CHARS=3000
# chat 图模型侧 token 预算（M6d）：超出预算的旧历史被修剪出模型输入。
MEMORY_CONTEXT_MAX_TOKENS=12000
# 注入快照缓存上限（成本治理 T2.1）：线程级冻结注入段的 LRU 容量。
MEMORY_CONTEXT_SNAPSHOT_MAX=256
# 会话历史压缩（#328）：buildModelInput 修剪不收缩 checkpointer 历史本体——
# 开启后每轮终态异步评估，历史 token 估算 > 输入预算×ratio 即折叠为
# 「压缩摘要 + 近 N 轮原文」写回。默认关闭（全链路零行为变化）；压缩走
# 快档（LLM_FAST_*，未配置回落主力），摘要以 SystemMessage 写回历史头部。
MEMORY_COMPACTION_ENABLED=false
# 压缩触发阈值：(0,1) 开区间，历史 token 估算 > 预算×ratio 触发。
MEMORY_COMPACTION_RATIO=0.7
# 压缩写回保留的近 N 轮原文（「轮」= 从一条 UserMessage 到下一条之前）。
MEMORY_COMPACTION_KEEP_RECENT_TURNS=3
# 四域预算拆分（条目 15）：SYSTEM/HISTORY/TOOL_RESULTS/INJECTION 各自独立
# 上限。四键均 0 = 关（现状逐字节；唯一例外是窗口生效时 systemPrompt 计入
# 输入预算的 R2-F1 收口，见 docs/java-differences.md）。
# SYSTEM 域：systemPrompt 独立硬顶（token）。0 = 只做收口扣减（窗口生效时
# 计入总预算挤占历史体，不截断 prompt）；>0 = 计得 tokens 超顶即启动报错
# （system 不可超=硬性，超限是配置错误不是裁剪场景）。
MEMORY_CONTEXT_BUDGET_SYSTEM_TOKENS=0
# HISTORY 域：历史体（尾部预算段）的独立上限（token）。0 = 沿用
# MEMORY_CONTEXT_MAX_TOKENS；>0 = 输入预算额外 min 封顶该值（与窗口无关）。
MEMORY_CONTEXT_BUDGET_HISTORY_TOKENS=0
# TOOL_RESULTS 域：单条工具结果超限告警的观测上限（token，含不可信标记行）。
# 0 = 关（零开销零日志）；>0 = 超限 WARN（只告警不截断不外置——外置由结果
# 外置条目承接，告警是过渡态观测面）。
MEMORY_CONTEXT_BUDGET_TOOL_RESULT_TOKENS=0
# INJECTION 域：注入块（冻结段/召回段）token 上限。0 = 沿用
# MEMORY_CONTEXT_MAX_CHARS 字符口径；>0 = 按 ceil(cap×5/3) 折算字符上限
# （CJK 0.6 token/char 的保守换算上界）并与 MEMORY_CONTEXT_MAX_CHARS 取小。
MEMORY_CONTEXT_BUDGET_INJECTION_TOKENS=0
# 记忆形成管线（M6c）：每 N 轮对话后台跑一次抽取+整合。
MEMORY_CAPTURE_ENABLED=true
MEMORY_CAPTURE_EVERY_TURNS=1
# 形成管线的模型分派（成本治理）：split=抽取/画像/摘要走快速档
# （LLM_FAST_*，未配置自动回落主力）、整合裁决走主力（默认）；
# all_main=全部主力（历史行为）；all_fast=全部走快档（显式覆盖，
# 仅在接受快档做整合裁决质量时使用）。
MEMORY_PIPELINE_PROFILE=split
# 会话滚动摘要（M6c/M6d）：线程内消息数超过阈值后触发摘要更新。
MEMORY_SUMMARY_ENABLED=true
MEMORY_SUMMARY_TRIGGER_MESSAGES=12
# 用户画像（M6c）：随对话合并演化的结构化画像。
MEMORY_PROFILE_ENABLED=true
# 遗忘策略：episodic 记忆保留天数（0 = 不过期）；检索打分的时间半衰期。
MEMORY_EPISODIC_TTL_DAYS=30
MEMORY_TIME_DECAY_HALF_LIFE_DAYS=14
# 向量下推（#324）：开启后召回候选池 = 向量 KNN top-100 ∪ 无向量候选，
# 解除「2000 候选全量打分」的容量天花板。默认关闭（全量打分语义不变）；
# 真下推后端（sqlite-vec / 外置向量库）就绪后按需打开。
MEMORY_VECTOR_PUSHDOWN=false
# 关键词下推（#326/#327）：开启后召回候选池先经后端关键词索引 top-200
# 收窄（sqlite=FTS5 bigram 表；MySQL=ngram FULLTEXT，需 MySQL 5.7.6+ 且
# ngram_token_size=2）。默认关闭（全量打分语义不变）；与向量下推独立。
MEMORY_BM25_PUSHDOWN=false
# 抽取管线的单次输入字符上限。
MEMORY_EXTRACTION_MAX_INPUT_CHARS=8000
# 抽取转写的消息条数窗口：超长会话只取最近 N 条，更早事实靠滚动摘要承载。
MEMORY_EXTRACTION_MAX_MESSAGES=24
# 记忆身份鉴权（P0）：配置后请求必须带
# X-User-Sig = HMAC-SHA256(user_id\ntimestamp\nnonce, 密钥)，否则 401
# （生成整组请求头：python scripts/memory_user_sig.py --user-id alice --secret <密钥>）。
# 留空仅限 development 单机自用；production 且 MEMORY_ENABLED=true 时强制要求。
MEMORY_AUTH_SECRET=
# 防重放时间窗（秒）：时间戳落在 now±窗口内的请求才被接受，nonce 窗口期内
# 只允许出现一次；0 = 退回仅覆盖 user_id 的旧签名方案（截获的请求头可无限期
# 重放，不推荐）。
MEMORY_AUTH_REPLAY_WINDOW_SECONDS=300
# nonce 重放缓存容量（LRU，#207）：超出即淘汰最旧。容量×窗口的乘积决定
# 重放防护强度；终解（外置共享存储）是多实例部署议题。
MEMORY_AUTH_REPLAY_CACHE_LIMIT=4096
# 敏感内容红线（#48，Java 先行）：命中 API key / 手机号 / 证件号等高置信
# 形态即拒绝入库（抽取与手工写入两路都过）。false 关闭整层检查。
MEMORY_SENSITIVE_CONTENT_FILTER=true
# 去重预筛（#38）：整合裁决前候选与既有记忆做余弦预筛，> 阈值直接跳过
# （内容几乎相同，省一次 LLM 调用）。阈值是 bge-m3 经验值，换模型须重校；
# 无 embedding 时预筛自动旁路。
MEMORY_DEDUP_PREFILTER=true
MEMORY_DEDUP_SKIP_COSINE=0.92
# 画像注入的硬截断上限（字符）。
MEMORY_PROFILE_MAX_CHARS=1500
# 记忆 MySQL 连接池大小（CHECKPOINTER_BACKEND=mysql 时生效）。
MEMORY_MYSQL_POOL_SIZE=5
# 混合检索权重（向量,关键词,时间,显著度），和必须为 1（误差 0.01）。
MEMORY_WEIGHT_VECTOR=0.40
MEMORY_WEIGHT_KEYWORD=0.30
MEMORY_WEIGHT_RECENCY=0.15
MEMORY_WEIGHT_SALIENCE=0.15
# 文档知识库分块（M6e）：块长 + 相邻块重叠（重叠必须小于块长）。
MEMORY_DOC_CHUNK_CHARS=800
MEMORY_DOC_CHUNK_OVERLAP=100

# ── 环境 ──────────────────────────────────────────────────────
# development | production
# production 会强制严格的配置校验（缺少密钥即快速失败）。
ENV=development

# ── 可观测性（可选，由环境开关控制，绝不硬编码） ─────────────
# 结构化 JSON 日志行。默认 false（人类可读）。生产部署应设为 true
# 以获得机器可解析的日志。
LOG_JSON=false
# /health 是否真实探测 LLM 端点可达性（会打真实网络，默认关闭——
# 关闭时只校验 key 非空与 base_url 格式；生产环境可按需开启）。
# 注意：键名是 HEALTH_PROBE_MODEL（不带 LLM_ 前缀——带前缀的旧写法
# 会被 llm_ 前缀规则吞进 LLM 节后静默丢弃，Java 侧现在显式拒绝）。
HEALTH_PROBE_MODEL=false
# LangSmith 追踪由 langchain 通过其环境变量原生消费；
# 基座只暴露它们的状态，绝不导入厂商 SDK。
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
# Langfuse（如使用）：public + secret 密钥会启用其原生回调。
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
