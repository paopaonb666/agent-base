<?xml version="1.0" encoding="UTF-8"?>
<!-- 记忆子系统模块：对应 packages/agent-base-memory（导入名 agent_base_memory）。
     依赖方向复刻 Python 的依赖倒置：本模块依赖基座的契约 SPI，
     经 ServiceLoader（META-INF/services）向基座注册 MemoryPluginProvider。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.paopaonb666</groupId>
    <artifactId>agent-base-java</artifactId>
    <version>0.3.0</version>
  </parent>

  <artifactId>agent-base-memory</artifactId>
  <name>agent-base-memory（记忆子系统）</name>
  <description>混合检索长期记忆：形成管线/常驻块/用户画像/文档知识库/版本审计</description>

  <dependencies>
    <dependency>
      <groupId>io.github.paopaonb666</groupId>
      <artifactId>agent-base</artifactId>
    </dependency>
    <!-- 存储后端驱动（store/ 的 sqlite 与 mysql 实现直接使用，与基座同版本）。 -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
    </dependency>
    <dependency>
      <groupId>com.mysql</groupId>
      <artifactId>mysql-connector-j</artifactId>
    </dependency>
    <!-- tags_json / offsets_json / detail_json 的编解码（store/ 直接使用）。 -->
    <dependency>
      <groupId>com.fasterxml.jackson.core</groupId>
      <artifactId>jackson-databind</artifactId>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- 「含记忆包」的部署 jar：Spring Boot repackage（主类在基座）。
           基座自身的 fat jar 不含记忆包（依赖方向 memory→base，对应 Python
           的可选发行包语义）；本 jar = 基座 + 记忆包的完整部署形态（对应
           Python 镜像里内置记忆包的形态）。 -->
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
        <configuration>
          <mainClass>io.github.paopaonb666.agentbase.entrypoints.server.AgentBaseApplication</mainClass>
        </configuration>
        <executions>
          <execution>
            <goals><goal>repackage</goal></goals>
            <configuration>
              <classifier>exec</classifier>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
